VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional — enables the "scan a bill" button in the expense form.
# Server-side only (never exposed to the browser): the photo is relayed to
# Gemini, the extracted text is returned, and the image is discarded.
# Without this key the app works exactly as before; the scan button just
# reports that scanning isn't configured.
GEMINI_API_KEY=your_google_ai_studio_key_here

# Optional override if the preferred model list ever goes stale.
# GEMINI_MODEL=gemini-3-flash-preview
